# Application
APP_NAME=FeedbackIQ API
DEBUG=true
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000

# Database (SQLite default; switch to PostgreSQL later)
DATABASE_URL=sqlite:///./feedbackiq.db

# Security
SECRET_KEY=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI models (set MOCK_AI=true to skip heavy model loading in dev)
MOCK_AI=false
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=./data/faiss_index.bin
FAISS_ID_MAP_PATH=./data/faiss_ids.json
