# Application
APP_NAME=FeedbackIQ API
DEBUG=true
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000

# Database (PostgreSQL is recommended for production)
DATABASE_URL=postgresql+psycopg://postgres:harsha@localhost:5432/feedbackiq

# Security
SECRET_KEY=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI models (set MOCK_AI=true to skip heavy model loading in dev)
MOCK_AI=false
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3
OLLAMA_TIMEOUT=120
FAISS_INDEX_PATH=./data/faiss_index.bin
FAISS_ID_MAP_PATH=./data/faiss_ids.json
